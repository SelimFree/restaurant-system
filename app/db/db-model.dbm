<dbmodel pgmodeler-ver="0.9.4" use-changelog="false" last-position="0,0" last-zoom="1" max-obj-count="4"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<role name="admin"
 encrypted="true"
 password="supersecretpassword">
</role>

<database name="restaurant_db" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" sql-disabled="true">
</schema>

<usertype name="user_roles" configuration="enumeration">
	<schema name="public"/>
	<role name="admin"/>
	<enumeration label="admin"/>
	<enumeration label="manager"/>
	<enumeration label="waiter"/>
	<enumeration label="kitchen"/>
</usertype>

<table name="users" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="admin"/>
	<position x="460" y="140"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="varchar" length="256"/>
	</column>
	<column name="email" not-null="true">
		<type name="varchar" length="256"/>
	</column>
	<column name="phone">
		<type name="varchar" length="64"/>
	</column>
	<column name="role" not-null="true">
		<type name="public.user_roles" length="32"/>
	</column>
	<column name="hashed_password" not-null="true">
		<type name="varchar" length="1024"/>
	</column>
	<column name="meta">
		<type name="json" length="0"/>
	</column>
	<constraint name="id_pk" type="pk-constr" table="public.users">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="email_uq" type="uq-constr" table="public.users">
		<columns names="email" ref-type="src-columns"/>
	</constraint>
</table>

</dbmodel>
